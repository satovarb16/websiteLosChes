---
import '../styles/global.css';
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";

interface Props {
  title: string;
  description: string;
  heading: string;
  current: 'privacidad' | 'terminos';
}

const { title, description, heading, current } = Astro.props;
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</head>

<body>

<header class="legal-nav">
  <div class="legal-nav-inner">
    <a href="/" class="legal-back" aria-label="Volver a inicio">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      Volver
    </a>
    <a href="/" class="legal-logo">
      <Image src={logo} alt="Los Ches" width={36} height={36} format="webp" />
    </a>
  </div>
</header>

<main class="legal-main">
  <div class="legal-inner">

    <div class="legal-header">
      <p class="legal-eyebrow">Legal</p>
      <h1>{heading}</h1>
      <p class="legal-meta">Última actualización: 2 de junio de 2025</p>
    </div>

    <div class="legal-body">
      <slot />
    </div>
  </div>
</main>

<footer class="legal-footer">
  <div class="legal-inner">
    <p>&copy; 2025 Los Ches Grill &amp; Meals. Todos los derechos reservados.</p>
    <nav aria-label="Legal">
      <a href="/privacidad" aria-current={current === 'privacidad' ? 'page' : undefined}>Política de privacidad</a>
      <span aria-hidden="true">·</span>
      <a href="/terminos" aria-current={current === 'terminos' ? 'page' : undefined}>Términos y condiciones</a>
    </nav>
  </div>
</footer>

</body>
</html>

<style>
.legal-nav {
  position: sticky;
  top: 0;
  z-index: 10;
  background-color: oklch(0.13 0.01 50 / 0.9);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--color-border);
}

.legal-nav-inner {
  max-width: 780px;
  margin-inline: auto;
  padding-inline: clamp(1.5rem, 5vw, 3rem);
  padding-block: 1rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.legal-back {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: var(--color-ink-muted);
  text-decoration: none;
  transition: color 150ms var(--ease-out);
}

.legal-back:hover { color: var(--color-primary); }

.legal-logo img { display: block; }

.legal-main {
  padding-block: clamp(3rem, 6vw, 6rem);
}

.legal-inner {
  max-width: 780px;
  margin-inline: auto;
  padding-inline: clamp(1.5rem, 5vw, 3rem);
}

.legal-header {
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 2.5rem;
}

.legal-eyebrow {
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-primary);
  margin-bottom: 1rem;
  max-width: none;
}

.legal-header h1 {
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -0.03em;
  line-height: 1.05;
  margin-bottom: 1rem;
}

.legal-meta {
  font-size: 0.875rem;
  color: var(--color-ink-muted);
  max-width: none;
}

.legal-body {
  display: flex;
  flex-direction: column;
  gap: clamp(2rem, 4vw, 3rem);
}

.legal-body section {
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
}

.legal-body h2 {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2vw, 1.375rem);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--color-ink);
}

.legal-body p {
  font-size: 0.9375rem;
  color: var(--color-ink-muted);
  line-height: 1.75;
  max-width: 68ch;
}

.legal-body ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
  padding-left: 0;
}

.legal-body ul li {
  font-size: 0.9375rem;
  color: var(--color-ink-muted);
  line-height: 1.7;
  padding-left: 1.25rem;
  position: relative;
  max-width: 68ch;
}

.legal-body ul li::before {
  content: '—';
  position: absolute;
  left: 0;
  color: var(--color-primary);
  font-size: 0.75rem;
  top: 0.35em;
}

.legal-body a {
  color: var(--color-primary);
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-color: oklch(0.63 0.245 35 / 0.4);
  transition: text-decoration-color 150ms;
}

.legal-body a:hover {
  text-decoration-color: var(--color-primary);
}

address {
  font-style: normal;
  font-size: 0.9375rem;
  color: var(--color-ink-muted);
  line-height: 1.9;
  max-width: none;
}

.legal-footer {
  border-top: 1px solid var(--color-border);
  padding-top: 2rem;
  padding-bottom: 2.75rem;
  margin-top: clamp(2.5rem, 5vw, 4rem);
}

.legal-footer .legal-inner {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem 2rem;
}

.legal-footer p {
  font-size: 0.8125rem;
  color: var(--color-ink-muted);
  opacity: 0.5;
  max-width: none;
}

.legal-footer a {
  font-size: 0.8125rem;
  color: var(--color-ink-muted);
  opacity: 0.65;
  text-decoration: none;
  transition: color 150ms var(--ease-out), opacity 150ms var(--ease-out);
}

.legal-footer nav {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.legal-footer a:hover { opacity: 1; color: var(--color-primary); }
.legal-footer a[aria-current="page"] { color: var(--color-primary); opacity: 1; }
.legal-footer span { opacity: 0.3; }
</style>
